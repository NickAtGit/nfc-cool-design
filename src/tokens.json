        "color-brand-tail": "#FFC709",
        "color-brand-highlight": "rgba(255, 255, 255, 0.18)",
        "elev-media": "0 30px 60px -20px rgba(0, 30, 70, 0.35), 0 8px 24px -8px rgba(0, 0, 0, 0.25)",

        "brand-blue-1": "#1276D0",
        "brand-blue-2": "#007BB9",

        "color-link": "#137BD9",
        "color-link-hover": "#00A2F3",
        "color-link-text": "#1272CA",
        "color-link-text-hover": "#0F5FA7",
        "color-link-light": "rgba(19, 123, 217, 0.12)",

        "color-on-brand": "#FFFFFF",
        "focus-halo": "#FFFFFF",
        "focus-stroke": "#212529",

        "color-shadow": "rgba(33, 37, 41, 0.06)",
        "color-shadow-lg": "rgba(33, 37, 41, 0.16)",

        "color-code-bg": "#0D1117",
        "color-code-text": "#E6EDF3",

        "color-success-fg": "#0A6E4A",
        "color-success-bg": "rgba(5, 150, 105, 0.12)",
        "color-success-border": "rgba(5, 150, 105, 0.45)",
        "color-warning-fg": "#8A5A0C",
        "color-warning-bg": "rgba(212, 130, 12, 0.14)",
        "color-warning-border": "rgba(212, 130, 12, 0.45)",
        "color-danger-fg": "#B3202A",
        "color-danger-bg": "rgba(207, 34, 46, 0.10)",
        "color-danger-border": "rgba(207, 34, 46, 0.45)",
        "color-info-fg": "#1272CA",
        "color-info-bg": "rgba(19, 123, 217, 0.10)",
        "color-info-border": "rgba(19, 123, 217, 0.40)",
        "color-neutral-fg": "#666D74",
        "color-neutral-bg": "rgba(33, 37, 41, 0.06)",
        "color-neutral-border": "#E6E8EB",

        "field-bg": "#FFFFFF",
        "field-border": "#767E86",

        "platform-ios-fg": "#136BC0",
        "platform-ios-bg": "rgba(19, 123, 217, 0.10)",
        "platform-ios-border": "rgba(19, 123, 217, 0.28)",
        "platform-android-fg": "#1C7A47",
        "platform-android-bg": "rgba(61, 220, 132, 0.14)",
        "platform-android-border": "rgba(61, 220, 132, 0.30)"
      },

      "dark": {
        "color-bg": "#161B22",
        "color-bg-alt": "#10151C",
        "color-bg-card": "#1C2128",

        "color-text": "#F0F2F5",
        "color-text-secondary": "#C2C8D0",
        "color-text-muted": "#8B949E",

        "color-border": "#30363D",
        "color-border-light": "#21262D",

        "color-accent": "#FFC709",
        "color-accent-hover": "#FFD93D",
        "color-accent-light": "rgba(255, 199, 9, 0.18)",
        "color-brand-tail": "#FFC709",
        "color-brand-highlight": "transparent",
        "elev-media": "0 30px 60px -20px rgba(255, 199, 9, 0.28), 0 8px 24px -8px rgba(255, 199, 9, 0.16)",

        "brand-blue-1": "#161B22",
        "brand-blue-2": "#161B22",

        "color-link": "#FFC709",
        "color-link-hover": "#FFD93D",
        "color-link-text": "#FFC709",
        "color-link-text-hover": "#FFD93D",
        "color-link-light": "rgba(255, 199, 9, 0.18)",

        "color-on-brand": "#F0F2F5",
        "focus-halo": "#0D1117",
        "focus-stroke": "#F0F2F5",

        "color-shadow": "rgba(0, 0, 0, 0.30)",
        "color-shadow-lg": "rgba(0, 0, 0, 0.50)",

        "color-code-bg": "#0D1117",
        "color-code-text": "#E6EDF3",

        "color-success-fg": "#3FB950",
        "color-success-bg": "rgba(63, 185, 80, 0.15)",
        "color-success-border": "rgba(63, 185, 80, 0.45)",
        "color-warning-fg": "#FFB454",
        "color-warning-bg": "rgba(255, 180, 84, 0.15)",
        "color-warning-border": "rgba(255, 180, 84, 0.45)",
        "color-danger-fg": "#FF7B72",
        "color-danger-bg": "rgba(255, 123, 114, 0.15)",
        "color-danger-border": "rgba(255, 123, 114, 0.45)",
        "color-info-fg": "#79C0FF",
        "color-info-bg": "rgba(121, 192, 255, 0.15)",
        "color-info-border": "rgba(121, 192, 255, 0.40)",
        "color-neutral-fg": "#8B949E",
        "color-neutral-bg": "rgba(240, 242, 245, 0.08)",
        "color-neutral-border": "#30363D",

        "field-bg": "#0D1117",
        "field-border": "#8B949E",

        "platform-ios-fg": "#00A2F3",
        "platform-ios-bg": "rgba(0, 162, 243, 0.12)",
        "platform-ios-border": "rgba(0, 162, 243, 0.34)",
        "platform-android-fg": "#5BE39A",
        "platform-android-bg": "rgba(61, 220, 132, 0.16)",
        "platform-android-border": "rgba(61, 220, 132, 0.32)"
      }
    }
  }
}
