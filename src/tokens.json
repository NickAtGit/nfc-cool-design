{
  "$comment": [
    "Source of truth for the NFC.cool design system.",
    "src/tokens.css and src/brands/*.css are GENERATED from this file by build/emit-css.mjs.",
    "Do not hand-edit those two outputs.",
    "",
    "Every value here is derived from nfc-cool-website's own CSS, or computed fresh",
    "against its palette. Nothing is imported from any other project."
  ],

  "breakpoints": {
    "$comment": "A var() cannot appear in a media condition, so these are constants enforced by test/guards.test.mjs. nfc.cool's seven literal breakpoints (1199/900/768/760/600/540/480) fold into these four: 760->md, 540->sm, 480->sm, 1199->xl.",
    "sm": 600,
    "md": 768,
    "lg": 900,
    "xl": 1200
  },

  "primitives": {
    "space": {
      "$comment": "4px grid. Keeps 1.25rem (space-5) because 20px is nfc.cool's signature grid gap and dropping it would re-space every card grid on the site.",
      "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem",
      "5": "1.25rem", "6": "1.5rem", "7": "2rem", "8": "2.5rem",
      "9": "3rem", "10": "4rem", "11": "5rem", "12": "6rem"
    },

    "section": {
      "$comment": "The three clamp() rhythms already present in landing.css / marketing.css / features.css, named.",
      "y-tight": "clamp(3rem, 6vw, 5rem)",
      "y": "clamp(3.5rem, 7vw, 6rem)",
      "y-loose": "clamp(4rem, 8vw, 7rem)"
    },

    "text": {
      "$comment": "Collapses ~14 unique clamp() expressions in the shipped CSS into one ladder.",
      "hero": "clamp(2.25rem, 6vw, 4rem)",
      "display": "clamp(2rem, 5vw, 3.25rem)",
      "title": "clamp(1.75rem, 3.5vw, 2.5rem)",
      "heading": "clamp(1.625rem, 3vw, 2.25rem)",
      "subhead": "clamp(1.375rem, 2.5vw, 1.75rem)",
      "lg": "1.25rem",
      "md": "1.125rem",
      "base": "1.0625rem",
      "body": "1rem",
      "sm": "0.9375rem",
      "xs": "0.8125rem",
      "2xs": "0.75rem",
      "3xs": "0.6875rem"
    },

    "leading": {
      "hero": "1.05",
      "display": "1.1",
      "heading": "1.15",
      "snug": "1.3",
      "normal": "1.55",
      "body": "1.65",
      "prose": "1.7"
    },

    "tracking": {
      "$comment": "The system's real typographic signature: negative on display sizes, positive on uppercase micro-labels. Reset to normal for Arabic, which is a connected script.",
      "hero": "-0.025em",
      "display": "-0.02em",
      "heading": "-0.015em",
      "normal": "0",
      "label": "0.04em",
      "eyebrow": "0.08em"
    },

    "measure": {
      "max": "1200px",
      "hero-media": "880px",
      "faq": "820px",
      "wide": "800px",
      "prose": "760px",
      "actions": "720px",
      "content": "680px",
      "gutter": "max(1.5rem, env(safe-area-inset-left), env(safe-area-inset-right))"
    },

    "radius": {
      "$comment": "nfc.cool's existing six, unchanged. 'base' and 'lg' are the two SiteKit emits from theme.yaml; the rest come from theme.css.",
      "sm": "4px",
      "base": "8px",
      "md": "10px",
      "lg": "14px",
      "xl": "32px",
      "pill": "999px"
    },

    "elevation": {
      "$comment": "Six ad-hoc shadows in the shipped CSS become four steps. These reference brand-layer shadow colors, resolved at use time.",
      "0": "0 1px 2px var(--color-shadow)",
      "1": "0 8px 24px var(--color-shadow-lg)",
      "2": "0 12px 32px var(--color-shadow-lg)",
      "3": "0 24px 60px -20px var(--color-shadow-lg)"
    },

    "motion": {
      "$comment": "Deliberately tiny: one duration, one gesture. No scroll animation, no reveal-on-scroll. Lift distances are tokenised so the three tiers stay distinguishable.",
      "transition": "0.2s ease",
      "lift-1": "-1px",
      "lift-2": "-2px",
      "lift-3": "-3px"
    }
  },

  "brands": {
    "nfccool": {
      "label": "NFC.cool",
      "font": {
        "heading": "\"Titillium Web\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "sans": "\"Titillium Web\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
        "script": "\"Caveat\", \"Brush Script MT\", cursive"
      },

      "light": {
        "color-bg": "#F5F6F8",
        "color-bg-alt": "#EDEFF3",
        "color-bg-card": "#FFFFFF",

        "color-text": "#212529",
        "color-text-secondary": "#495057",
        "color-text-muted": "#666D74",

        "color-border": "#E6E8EB",
