{
  "name": "@nfccool/design",
  "version": "0.1.0",
  "description": "The NFC.cool design system: tokens, components and marketing archetypes shared across every NFC.cool web presence.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "files": [
    "consumers.json",
    "dist",
    "docs",
    "src"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./brands/nfccool.css": "./src/brands/nfccool.css",
    "./components.css": "./src/components.css",
    "./archetypes.css": "./src/archetypes.css",
    "./email.css": "./src/email.css",
    "./tokens.json": "./src/tokens.json",
    "./nav.js": "./src/nav.js",
    "./theme.js": "./src/theme.js"
  },
  "scripts": {
    "build": "node build/emit-css.mjs && node build/emit-bundle.mjs && node build/emit-guideline.mjs && node build/sync-consumers.mjs",
    "guideline": "node build/emit-guideline.mjs",
    "sitekit": "node build/emit-sitekit-theme.mjs",
    "test": "node --test test/*.test.mjs",
    "sync": "node build/sync-consumers.mjs",
    "sync:check": "node build/sync-consumers.mjs --check"
  }
}
